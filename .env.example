# =============================================================================
# CONFIGURAÇÕES DO BOT - MERCADO LATERAL
# =============================================================================
# Renomeie este arquivo para .env e preencha com suas chaves

# =============================================================================
# API KEYS BINANCE FUTURES
# =============================================================================
BINANCEAPIKEY=sua_chave_api_aqui
BINANCEAPISECRET=sua_chave_secreta_aqui

# =============================================================================
# MODO DE OPERAÇÃO
# =============================================================================
# live = usa capital real
# paper = modo simulação (recomendado para testes)
BOT_MODE=paper

# =============================================================================
# PARÂMETROS DE TRADING
# =============================================================================
# Alavancagem (2x recomendado para lateral)
LEVERAGE=2

# Tamanho da posição por trade (% do saldo)
POSITION_SIZE_PCT=0.05

# Saldo mínimo em USDT
MIN_BALANCE_USDT=0.60

# Máximo de posições abertas simultâneas
MAX_OPEN_POSITIONS=3

# =============================================================================
# INDICADORES (OPCIONAL - usa defaults se não definido)
# =============================================================================
# Período do Bollinger Bands (padrão: 20)
BB_PERIOD=20

# Desvio padrão do BB (padrão: 2.0)
BB_STD_DEV=2.0

# Período do RSI (padrão: 14)
RSI_PERIOD=14

# Período do Stochastic K (padrão: 14)
STOCH_K_PERIOD=14

# Período do Stochastic D (padrão: 3)
STOCH_D_PERIOD=3

# Período do Williams %R (padrão: 14)
WILLIAMS_PERIOD=14

# Lookback para Suporte/Resistência (padrão: 50)
SR_LOOKBACK=50

# Proximidade da banda para entrada (padrão: 0.02 = 2%)
MIN_BB_PROXIMITY=0.02

# =============================================================================
# LOGGING
# =============================================================================
# Nível de log: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
