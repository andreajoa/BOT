# =============================================================================
# ADAPTIVE BINANCE FUTURES EXECUTOR
# Copie para .env APENAS no runtime local. Nunca faça commit do .env real.
# =============================================================================

# Binance Futures (segredos locais)
BINANCEAPIKEY=
BINANCEAPISECRET=

# Modo de cerebro.
# external_chatgpt = ChatGPT desta conta analisa externamente via canal privado Neon.
# openai_api       = modo alternativo que chama a OpenAI API a partir do runtime.
BRAIN_MODE=external_chatgpt

# Canal privado de telemetria/propostas usado por external_chatgpt.
# Segredo local. Nunca colocar no GitHub.
NEON_DATABASE_URL=
NEON_TELEMETRY_INTERVAL_SECONDS=15
EXTERNAL_PROPOSAL_POLL_SECONDS=5

# Somente para BRAIN_MODE=openai_api (NAO usado no modo external_chatgpt).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Fail-closed. O runtime exige explicitamente BOT_MODE=live.
BOT_MODE=disabled

# =============================================================================
# HARD LIMITS / INTEGRIDADE
# Não são estratégia; são limites máximos aceitos pelo executor.
# =============================================================================
MAX_LEVERAGE_HARD=20
MAX_MARGIN_USAGE_PCT=0.95
SINGLE_POSITION_BELOW_USDT=5.0
MAX_OPEN_POSITIONS_HARD=3
# Perda estimada máxima até o stop como fração do saldo disponível.
MAX_LOSS_PCT_BALANCE_HARD=0.35
# Estimativa conservadora de taker fee por lado usada no preflight de risco.
ESTIMATED_TAKER_FEE_RATE=0.0005

# =============================================================================
# UNIVERSO E CADÊNCIA
# =============================================================================
SCANNER_MAX_SYMBOLS=15
UNIVERSE_REFRESH_SECONDS=300
BRAIN_DECISION_INTERVAL_SECONDS=20
BRAIN_COMMAND_TTL_SECONDS=90
DERIVATIVES_INTERVAL_SECONDS=60
STRUCTURE_INTERVAL_SECONDS=30
STATUS_INTERVAL_SECONDS=2

# Logging
LOG_LEVEL=INFO

# =============================================================================
# CONFIGURAÇÕES LEGADAS
# Mantidas apenas se você executar módulos antigos diretamente. O main.py novo
# não usa a estratégia fixa de Mean Reversion.
# =============================================================================
LEVERAGE=2
POSITION_SIZE_PCT=0.05
MIN_BALANCE_USDT=0.60
MAX_OPEN_POSITIONS=3
BB_PERIOD=20
BB_STD_DEV=2.0
RSI_PERIOD=14
STOCH_K_PERIOD=14
STOCH_D_PERIOD=3
WILLIAMS_PERIOD=14
SR_LOOKBACK=50
MIN_BB_PROXIMITY=0.02
